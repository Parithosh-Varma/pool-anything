{
  "name": "pool-anything",
  "version": "0.1.1",
  "description": "Gather free-tier API keys from any provider into one pool and rotate through them — round-robin key selection, usage/quota tracking, and a drop-in HTTP proxy with a built-in web UI. Dependency-free server core, TypeScript + SQLite.",
  "keywords": [
    "api-key-pool",
    "key-rotation",
    "api-proxy",
    "round-robin",
    "free-tier",
    "rate-limit",
    "llm-gateway",
    "api-gateway",
    "usage-tracking",
    "quota",
    "sqlite",
    "typescript",
    "ink-tui",
    "groq",
    "openrouter",
    "gemini",
    "anthropic",
    "openai",
    "self-hosted"
  ],
  "homepage": "https://github.com/Parithosh-Varma/pool-anything#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parithosh-Varma/pool-anything.git"
  },
  "bugs": {
    "url": "https://github.com/Parithosh-Varma/pool-anything/issues"
  },
  "license": "Apache-2.0",
  "author": "Parithosh Varma",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "pool-anything": "bin/pool-anything.js"
  },
  "files": [
    "dist/",
    "bin/",
    "data/providers.json",
    "public/logos/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/db/init.ts",
    "export:tools": "tsx scripts/export-tools-ui.ts",
    "tools:daemon": "tsx scripts/tools-watch.ts",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "start:dist": "node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^19.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0"
  }
}
