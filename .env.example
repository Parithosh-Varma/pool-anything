# Copy to .env to override defaults. All optional.
# Port for the web UI + API (single server).
PORT=3000
# SQLite file (D1 stand-in). Defaults to ./data/pool-anything.db
LOCAL_DB_PATH=./data/pool-anything.db
# Proxy upstream timeout in ms.
PROXY_TIMEOUT_MS=30000
# Set to 1 in tests/loopback only. Never in prod: allows http + private hosts upstream.
ALLOW_PRIVATE_UPSTREAM=
