{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pool-anything",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-25",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://pool-anything-tools.pages.dev,https://pool-anything.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pool-anything",
      // TODO: replace with the id from `wrangler d1 create pool-anything`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ]
}
