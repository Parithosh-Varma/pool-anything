{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pool-anything",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-25",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://pool-anything-tools.pages.dev,https://pool-anything.pages.dev"
  },
  // One SQLite-backed Durable Object holds all pool state. Free-plan eligible,
  // and serialized writes give exact rotation without D1.
  "durable_objects": {
    "bindings": [
      {
        "name": "POOL_DB",
        "class_name": "PoolDB"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PoolDB"]
    }
  ]
}
